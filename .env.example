# Copia este fichero a .env y rellénalo. Los valores vacíos son obligatorios u opcionales según el README.

# Ruta host de music_rater.db (bind mount — requiere recrear el contenedor)
MIX_RATER_DB_PATH=
# Ruta host de la colección a escanear (bind mount, solo lectura — requiere recrear el contenedor)
MIX_RATER_MUSIC_PATH=
MUSIC_RATER_DB=
SETTINGS_PASSWORD=

# ── docker-compose.yml ──────────────────────────────────────────
# Carpeta de música que se puntúa (obligatoria)
MUSICA=
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
